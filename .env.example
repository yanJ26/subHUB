# Browser owner login. Generate unique high-entropy values; never commit real values.
SUBHUB_WEB_PASSWORD=replace-with-a-strong-owner-password
SUBHUB_WEB_SESSION_SECRET=replace-with-a-long-random-session-secret
SUBHUB_WEB_INTERNAL_TOKEN=replace-with-a-different-long-random-internal-token

SUBHUB_GATEWAY_HOST=0.0.0.0
SUBHUB_GATEWAY_PORT=8790
SUBHUB_DB_PATH=/data/subhub.sqlite
SUBHUB_GATEWAY_INTERNAL_URL=http://subhub-gateway:8790/v1/web

# Exact browser origin accepted for state-changing requests. Do not include a path.
SUBHUB_PUBLIC_ORIGIN=https://subhub.example.com
# Keep false for the recommended global owner limiter. Enable only behind a proxy that overwrites client IP headers.
SUBHUB_TRUST_PROXY_HEADERS=false

# Empty serves at /. For subhub.example.com deployment use /code/subhub.
NEXT_PUBLIC_BASE_PATH=/code/subhub

# Official ECB reference feed; refreshed at most once per UTC month.
SUBHUB_EXCHANGE_RATE_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml
SUBHUB_MAX_BODY_BYTES=2097152
SUBHUB_BACKUP_DIR=/backups
SUBHUB_BACKUP_RETENTION=14
