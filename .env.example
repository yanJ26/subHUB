# API Hub Gateway only listens on the VPS loopback interface by default.
APIHUB_GATEWAY_HOST=0.0.0.0
APIHUB_GATEWAY_PORT=8787
APIHUB_DB_PATH=/data/apihub.sqlite

# Generate unique high-entropy values on the VPS. Never commit real values.
APIHUB_OPENCLAW_TOKEN=replace-with-a-long-random-token
APIHUB_OPENCLAW_HMAC_SECRET=replace-with-a-different-long-random-secret

# Browser login and the private Web-to-Gateway channel.
APIHUB_WEB_PASSWORD=replace-with-a-strong-owner-password
APIHUB_WEB_SESSION_SECRET=replace-with-a-long-random-session-secret
APIHUB_WEB_INTERNAL_TOKEN=replace-with-a-long-random-internal-token

# OpenAI-compatible endpoint with strict JSON Schema support.
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Back this value up separately. Losing it makes saved BYOK keys unrecoverable.
APIHUB_SECRETS_MASTER_KEY=replace-with-base64-encoded-32-byte-key

# Optional server-side fallback. The encrypted BYOK values saved in the Web settings page take priority.
APIHUB_GATE_MODEL_BASE_URL=https://provider.example/v1
APIHUB_GATE_MODEL=replace-with-model-id
APIHUB_GATE_MODEL_API_KEY=replace-with-server-side-api-key
APIHUB_ALLOW_PRIVATE_MODEL_ENDPOINTS=false

APIHUB_GATE_CONFIDENCE_THRESHOLD=0.85
APIHUB_APPROVAL_TTL_MINUTES=15

# Optional. The Gateway checks this official feed at most once per UTC month.
APIHUB_EXCHANGE_RATE_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml
